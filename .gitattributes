# Normalize line endings for cross-platform builds.
# Scripts that run inside the Linux Docker image MUST stay LF, otherwise a
# Windows checkout (autocrlf) rewrites their shebang to CRLF and the container
# fails with "bad interpreter: /usr/bin/env python3^M".
* text=auto eol=lf

*.py   text eol=lf
*.sh   text eol=lf
Dockerfile      text eol=lf
docker-compose.yml text eol=lf

# Treat known binaries as binary (never touch their bytes).
*.bin  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.pdf  binary
*.a    binary
*.so   binary
*.dylib binary
