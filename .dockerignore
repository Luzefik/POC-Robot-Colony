# Keep the build context small and reproducible.
# NOTE: build/ and managed_components/ are intentionally excluded so a host
# build (possibly wrong-arch) never leaks into the image. At runtime the
# project is bind-mounted over /project anyway (see docker-compose.yml).

.git
.gitignore
.gitattributes
.dockerignore
.vscode
.idea

# Host build outputs / generated dirs
build/
Build/
BUILD/
managed_components/
sdkconfig.old

# Docs & local files not needed to build firmware
documentation/
*.md
!README.md
how-to.txt
LICENSE

# OS cruft
.DS_Store
._*
*.log
*.tmp
